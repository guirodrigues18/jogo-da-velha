# Configuração do Firebase para o modo online.
# Onde encontrar: console do Firebase → Configurações do projeto → Seus apps → Web.
# Esses valores são públicos por natureza (vão para o navegador); a segurança
# fica nas regras do banco, em database.rules.json.
# Copie este arquivo para .env e preencha. Sem eles, o jogo funciona só no modo local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcional: Google Analytics (ativado pelo Firebase; o id começa com G-)
VITE_FIREBASE_MEASUREMENT_ID=
